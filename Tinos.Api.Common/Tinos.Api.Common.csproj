    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Executable.Lua" Version="4.0.1" />
    <PackageReference Include="Cosmos.Kernel" Version="3.0.99" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Graphics\" />
  </ItemGroup>

</Project>
